<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#bcbcbc</item>
        <item name="android:colorControlHighlight">#33808080</item>
        <item name="android:colorControlActivated">#bcbcbc</item>
        <item name="android:textColorHighlight">#55808080</item>
        <item name="android:selectableItemBackground">@drawable/tap_feedback</item>
        <item name="android:listSelector">@drawable/tap_feedback</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#080808</item>
        <item name="android:navigationBarColor">#111111</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#080808</item>
    </style>
    <style name="DevSurfDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#bcbcbc</item>
        <item name="android:colorControlHighlight">#33808080</item>
        <item name="android:textColorPrimary">#f5f5f5</item>
        <item name="android:textColorSecondary">#8d8d8d</item>
        <item name="android:textColorHighlight">#55808080</item>
        <item name="android:windowBackground">@drawable/dialog_panel</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="android:backgroundDimAmount">0.65</item>
        <item name="android:listSelector">@drawable/tap_feedback</item>
        <item name="android:selectableItemBackground">@drawable/tap_feedback</item>
    </style>
    <style name="DevSurfDialogLight" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#656565</item>
        <item name="android:colorControlHighlight">#33808080</item>
        <item name="android:textColorPrimary">#161616</item>
        <item name="android:textColorSecondary">#656565</item>
        <item name="android:textColorHighlight">#55808080</item>
        <item name="android:windowBackground">@drawable/dialog_panel_light</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:listSelector">@drawable/tap_feedback</item>
        <item name="android:selectableItemBackground">@drawable/tap_feedback</item>
    </style>
</resources>
